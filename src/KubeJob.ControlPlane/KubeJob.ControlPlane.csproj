<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>KubeJob durable control-plane runtime and storage contracts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\KubeJob.Server\ControlPlane\**\*.cs" LinkBase="ControlPlane" />
    <!--
      Keep the public source namespaces stable while making the assembly seam
      explicit. Only durable runtime rules, storage contracts, and hosted
      reconciliation belong to the control plane. HTTP/typed-client and
      in-process worker adapters stay in KubeJob.Server.
    -->
    <Compile Include="..\KubeJob.Server\Runtime\CronScheduleCalculator.cs" Link="Runtime\CronScheduleCalculator.cs" />
    <Compile Include="..\KubeJob.Server\Runtime\IJobRuntimeStores.cs" Link="Runtime\IJobRuntimeStores.cs" />
    <Compile Include="..\KubeJob.Server\Runtime\InMemoryJobRuntimeStore*.cs" LinkBase="Runtime" />
    <Compile Include="..\KubeJob.Server\Runtime\JobRuntimeDashboardModels.cs" Link="Runtime\JobRuntimeDashboardModels.cs" />
    <Compile Include="..\KubeJob.Server\Runtime\JobRuntimeHostedServices.cs" Link="Runtime\JobRuntimeHostedServices.cs" />
    <Compile Include="..\KubeJob.Server\Runtime\JobRuntimeOptions.cs" Link="Runtime\JobRuntimeOptions.cs" />
    <Compile Include="..\KubeJob.Server\Runtime\JobSubmissionIdentity.cs" Link="Runtime\JobSubmissionIdentity.cs" />
    <Compile Include="..\KubeJob.Server\Runtime\QueueRouting.cs" Link="Runtime\QueueRouting.cs" />
    <Compile Include="..\KubeJob.Server\Runtime\ScheduleReconciliationPlanner.cs" Link="Runtime\ScheduleReconciliationPlanner.cs" />
    <Compile Include="..\KubeJob.Server\Runtime\ScheduleReconcilerService.cs" Link="Runtime\ScheduleReconcilerService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.11.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KubeJob.Core\KubeJob.Core.csproj" />
  </ItemGroup>

</Project>
