<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KubeJob</title>
    <script>
        (function () {
            try {
                document.documentElement.setAttribute("data-theme", localStorage.getItem("kubejob-dashboard-theme") || "light");
            } catch (_) { }
        })();
    </script>
    <link rel="stylesheet" href="~/_content/KubeJob.Server/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    @{
        var action = ViewContext.RouteData.Values["Action"]?.ToString();
    }
    <header class="kj-header">
        <div class="kj-header-inner">
            <a asp-controller="Dashboard" asp-action="Index" class="kj-brand">KubeJob</a>
            <nav class="kj-nav" aria-label="Dashboard">
                <a asp-controller="Dashboard" asp-action="Index" class="kj-nav-link @(action == "Index" ? "active" : "")">Dashboard</a>
                <a asp-controller="Dashboard" asp-action="Runs" class="kj-nav-link @(action == "Runs" ? "active" : "")">Jobs</a>
                <a asp-controller="Dashboard" asp-action="Specs" class="kj-nav-link @(action == "Specs" ? "active" : "")">Recurring Jobs</a>
                <a asp-controller="Dashboard" asp-action="Nodes" class="kj-nav-link @(action == "Nodes" ? "active" : "")">Servers</a>
            </nav>
            <div class="kj-header-actions">
                @RenderSection("TopbarActions", required: false)
                <button id="kj-theme-toggle" class="kj-btn kj-btn-outline" type="button" aria-label="Toggle color theme">Dark mode</button>
            </div>
        </div>
    </header>
    <main class="kj-container">
        <div class="kj-page-head">
            <h1 class="kj-page-title">@ViewData["Title"]</h1>
            <div class="kj-page-actions">@RenderSection("PageActions", required: false)</div>
        </div>
        @RenderBody()
    </main>
    <script src="~/_content/KubeJob.Server/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>
