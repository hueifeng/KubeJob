<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KubeJob</title>
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/zephyr/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        :root { --sidebar-width: 248px; }
        body { background: #f4f6f9; color: #0f172a; }
        .sidebar {
            position: fixed; inset: 0 auto 0 0; width: var(--sidebar-width);
            background: linear-gradient(180deg, #111827 0%, #020617 100%);
            box-shadow: 2px 0 12px rgba(15, 23, 42, .18); z-index: 1030;
        }
        .brand { color: white; padding: 1.35rem; font-weight: 800; font-size: 1.35rem; border-bottom: 1px solid rgba(255,255,255,.08); }
        .brand small { display: block; color: #94a3b8; font-size: .7rem; letter-spacing: .12em; margin-top: .2rem; }
        .sidebar .nav-link { color: #cbd5e1; border-radius: .65rem; margin: .2rem .85rem; padding: .75rem .9rem; display: flex; align-items: center; gap: .75rem; }
        .sidebar .nav-link:hover { color: white; background: rgba(255,255,255,.08); }
        .sidebar .nav-link.active { color: white; background: #2563eb; box-shadow: 0 8px 24px rgba(37, 99, 235, .28); }
        .main-wrapper { margin-left: var(--sidebar-width); min-height: 100vh; }
        .topbar { position: sticky; top: 0; z-index: 1020; min-height: 64px; background: rgba(255,255,255,.94); backdrop-filter: blur(8px); border-bottom: 1px solid #e2e8f0; padding: .75rem 1.75rem; display: flex; align-items: center; justify-content: space-between; }
        .content-area { padding: 1.75rem; }
        .section-header { background: white; border: 1px solid #e2e8f0; border-radius: .9rem; padding: 1rem 1.25rem; box-shadow: 0 4px 12px rgba(15, 23, 42, .04); margin-bottom: 1.25rem; }
        .stats-card, .table-card, .detail-card { border: 1px solid #e2e8f0; border-radius: .9rem; background: white; box-shadow: 0 6px 18px rgba(15, 23, 42, .05); }
        .stats-card { overflow: hidden; height: 100%; }
        .stats-card .card-body { position: relative; padding: 1.2rem; }
        .stats-icon { position: absolute; right: 1rem; bottom: .65rem; font-size: 2.5rem; opacity: .13; }
        .table-card { padding: .55rem; }
        .table > :not(caption) > * > * { padding: .85rem 1rem; vertical-align: middle; }
        .table thead th { background: #f8fafc; color: #475569; border-bottom: 1px solid #e2e8f0; text-transform: uppercase; letter-spacing: .06em; font-size: .72rem; white-space: nowrap; }
        .table tbody tr:hover { background: #f8fafc; }
        .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
        .key-value dt { color: #64748b; font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; }
        .key-value dd { margin-bottom: 1rem; word-break: break-word; }
        .status-dot { width: .55rem; height: .55rem; display: inline-block; border-radius: 50%; margin-right: .35rem; }
        .payload { max-height: 24rem; overflow: auto; background: #0f172a; color: #e2e8f0; border-radius: .6rem; padding: 1rem; white-space: pre-wrap; word-break: break-word; }
        @@media (max-width: 900px) {
            :root { --sidebar-width: 78px; }
            .sidebar .label, .brand span, .brand small { display: none; }
            .sidebar .nav-link { justify-content: center; font-size: 1.1rem; }
            .content-area { padding: 1rem; }
        }
    </style>
</head>
<body>
@{
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
}
<aside class="sidebar">
    <div class="brand">
        <i class="fa-solid fa-cubes-stacked me-2"></i><span>KubeJob</span>
        <small>V2 CONTROL PLANE</small>
    </div>
    <nav class="mt-3">
        <a asp-controller="Dashboard" asp-action="Index" class="nav-link @(action == "Index" ? "active" : "")">
            <i class="fa-solid fa-gauge-high"></i><span class="label">Overview</span>
        </a>
        <a asp-controller="Dashboard" asp-action="Runs" class="nav-link @(action is "Runs" or "Run" ? "active" : "")">
            <i class="fa-solid fa-list-check"></i><span class="label">Runs & Attempts</span>
        </a>
        <a asp-controller="Dashboard" asp-action="Workers" class="nav-link @(action == "Workers" ? "active" : "")">
            <i class="fa-solid fa-server"></i><span class="label">Worker Sessions</span>
        </a>
        <a asp-controller="Dashboard" asp-action="Schedules" class="nav-link @(action == "Schedules" ? "active" : "")">
            <i class="fa-solid fa-calendar-days"></i><span class="label">Schedules</span>
        </a>
    </nav>
</aside>
<div class="main-wrapper">
    <header class="topbar">
        <div>
            <div class="text-muted small">KubeJob distributed runtime</div>
            <h5 class="m-0 fw-bold">@ViewData["Title"]</h5>
        </div>
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
            <span class="status-dot bg-success"></span>V2 only
        </span>
    </header>
    <main class="content-area">@RenderBody()</main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
