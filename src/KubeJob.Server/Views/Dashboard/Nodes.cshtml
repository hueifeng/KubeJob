@using KubeJob.Core.Domain
@using System.Text.Json
@model IEnumerable<WorkerNode>
@{
    ViewData["Title"] = "Servers";
}

@section TopbarActions {
    <div class="kj-live-meta">
        <span data-kj-refresh-status class="kj-live-chip is-ok">Live</span>
        <span data-kj-refresh-details>Loading updates...</span>
    </div>
}

@section PageActions {
    <button class="kj-btn kj-btn-outline" type="button" onclick="location.reload()">Refresh</button>
}

<div data-kj-refresh-endpoint="api/nodes" data-kj-refresh-interval-ms="10000" data-kj-delete-url-template="@Url.Action("DeleteNode", "Dashboard", new { id = "__NODE_ID__" })">
    <section class="kj-card">
        <div class="kj-table-wrap">
            <table class="kj-table">
                <thead><tr><th>Server</th><th>Status</th><th>Load</th><th>Queues / labels</th><th>Heartbeat</th><th></th></tr></thead>
                <tbody id="kj-nodes">
                @foreach (var node in Model)
                {
                    var labels = new Dictionary<string, string>();
                    if (!string.IsNullOrWhiteSpace(node.Labels))
                    {
                        try { labels = JsonSerializer.Deserialize<Dictionary<string, string>>(node.Labels) ?? new(); } catch (JsonException) { }
                    }
                    var pct = node.MaxCapacity <= 0 ? 0 : Math.Min(100, (int)Math.Round(node.CurrentLoad * 100d / node.MaxCapacity));
                    var loadClass = pct >= 90 ? "is-danger" : pct >= 70 ? "is-warning" : "";
                    <tr>
                        <td><div class="kj-mono">@node.Id</div><div class="kj-muted">@node.IpAddress</div></td>
                        <td><span class="kj-pill @(node.IsOffline ? "status-canceled" : "status-succeeded")">@(node.IsOffline ? "Offline" : "Online")</span></td>
                        <td><div>@node.CurrentLoad / @node.MaxCapacity</div><div class="kj-load @loadClass"><span style="width:@pct%"></span></div></td>
                        <td>@if (labels.Any()) { foreach (var label in labels) { <span class="kj-pill">@label.Key:@label.Value</span> } } else { <span class="kj-muted">No labels</span> }</td>
                        <td>@node.LastHeartbeat.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@if (node.IsOffline) { <form asp-action="DeleteNode" asp-route-id="@node.Id" method="post" onsubmit="return confirm('Remove this offline server?');">@Html.AntiForgeryToken()<button type="submit" class="kj-btn kj-btn-danger">Remove</button></form> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    <div hidden><form id="kj-antiforgery-template">@Html.AntiForgeryToken()</form></div>
</div>

<script>
(() => {
    const cell = (value, className) => { const el = document.createElement("td"); if (className) el.className = className; if (value instanceof Node) el.append(value); else el.textContent = value; return el; };
    const pill = (text, className) => { const el = document.createElement("span"); el.className = `kj-pill ${className}`; el.textContent = text; return el; };
    const labelsCell = labels => {
        const wrap = document.createElement("div");
        Object.entries(labels || {}).forEach(([key, value]) => wrap.append(pill(`${key}:${value}`)));
        if (!wrap.childNodes.length) wrap.append(document.createTextNode("No labels"));
        return wrap;
    };
    const deleteForm = (root, id) => {
        const form = document.createElement("form");
        form.method = "post"; form.action = root.dataset.kjDeleteUrlTemplate.replace("__NODE_ID__", encodeURIComponent(id));
        form.onsubmit = () => confirm("Remove this offline server?");
        const token = document.querySelector("#kj-antiforgery-template input");
        if (token) { const input = document.createElement("input"); input.type = "hidden"; input.name = token.name; input.value = token.value; form.append(input); }
        const button = document.createElement("button"); button.type = "submit"; button.className = "kj-btn kj-btn-danger"; button.textContent = "Remove"; form.append(button);
        return form;
    };
    window.kubeJobDashboardRender = (root, data) => {
        const body = root.querySelector("#kj-nodes"); if (!body) return;
        body.replaceChildren();
        const nodes = Array.isArray(data) ? data : [];
        if (!nodes.length) { const row = document.createElement("tr"); const empty = cell("No servers are registered.", "kj-empty"); empty.colSpan = 6; row.append(empty); body.append(row); return; }
        nodes.forEach(node => {
            let labels = {};
            try { labels = JSON.parse(node.labels || "{}"); } catch (_) { }
            const current = Number(node.currentLoad || 0), max = Number(node.maxCapacity || 0);
            const percentage = max > 0 ? Math.min(100, Math.round(current * 100 / max)) : 0;
            const row = document.createElement("tr");
            const server = document.createElement("td"); server.append(Object.assign(document.createElement("div"), { className: "kj-mono", textContent: node.id || "" }), Object.assign(document.createElement("div"), { className: "kj-muted", textContent: node.ipAddress || "" }));
            const load = document.createElement("div"); load.textContent = `${current} / ${max}`; const bar = document.createElement("div"); bar.className = `kj-load ${percentage >= 90 ? "is-danger" : percentage >= 70 ? "is-warning" : ""}`; const fill = document.createElement("span"); fill.style.width = `${percentage}%`; bar.append(fill); load.append(bar);
            row.append(server, cell(pill(node.isOffline ? "Offline" : "Online", node.isOffline ? "status-canceled" : "status-succeeded")), cell(load), cell(labelsCell(labels)), cell(window.kubeJobDashboardUtils.safeLocalDateTime(node.lastHeartbeat)));
            const actions = document.createElement("td"); if (node.isOffline) actions.append(deleteForm(root, String(node.id || ""))); row.append(actions);
            body.append(row);
        });
    };
})();
</script>
