@using KubeJob.Core.Domain
@model IEnumerable<JobSpec>
@{
    ViewData["Title"] = "Recurring jobs";
    string PageUrl(int page) => Url.Action("Specs", new { page, pageSize = ViewBag.PageSize })!;
}

<section class="kj-card">
    <div class="kj-table-wrap">
        <table class="kj-table">
            <thead><tr><th>Id</th><th>Cron</th><th>Next execution</th><th>Queue policy</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="kj-empty">No recurring jobs have been configured.</td></tr>
            }
            else
            {
                @foreach (var spec in Model)
                {
                    <tr>
                        <td><div>@spec.Name</div><div class="kj-muted kj-mono">@spec.Id</div></td>
                        <td><div class="kj-mono">@spec.CronExpression</div><div class="kj-muted">Timeout @spec.TimeoutSeconds s · @spec.TotalShards shard(s)</div></td>
                        <td>@(spec.IsDisabled ? "Paused" : spec.NextRunTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "Pending")</td>
                        <td><span class="kj-pill">@spec.ExecuteModel</span> <span class="kj-pill">@spec.ConcurrencyPolicy</span></td>
                        <td><span class="kj-pill @(spec.IsDisabled ? "status-pending" : "status-succeeded")">@(spec.IsDisabled ? "Paused" : "Active")</span></td>
                        <td>
                            <div class="kj-actions">
                                <form asp-action="TriggerSpec" asp-route-id="@spec.Id" method="post"><button class="kj-btn" type="submit" disabled="@(spec.IsDisabled ? "disabled" : null)">Trigger now</button></form>
                                <form asp-action="ToggleSpec" asp-route-id="@spec.Id" method="post">
                                    <input type="hidden" name="isDisabled" value="@(!spec.IsDisabled)" />
                                    <button class="kj-btn kj-btn-outline" type="submit">@(spec.IsDisabled ? "Resume" : "Pause")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    @if (ViewBag.TotalPages > 0)
    {
        <div class="kj-pagination">
            <span class="kj-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages · @ViewBag.TotalCount recurring jobs</span>
            <form class="kj-page-size" method="get"><input type="hidden" name="page" value="1" /><label class="kj-muted" for="pageSize">Rows</label><select id="pageSize" name="pageSize" onchange="this.form.submit()">@foreach (var size in new[] { 10, 20, 50, 100 }) { <option value="@size" selected="@(ViewBag.PageSize == size ? "selected" : null)">@size</option> }</select></form>
            <div class="kj-page-links">
                @if (ViewBag.CurrentPage > 1) { <a href="@PageUrl(ViewBag.CurrentPage - 1)">Prev</a> } else { <span>Prev</span> }
                @if (ViewBag.CurrentPage < ViewBag.TotalPages) { <a href="@PageUrl(ViewBag.CurrentPage + 1)">Next</a> } else { <span>Next</span> }
            </div>
        </div>
    }
</section>
