@using KubeJob.Core.Domain
@model IEnumerable<JobSpec>
@{
    ViewData["Title"] = "Job Specifications";
}

<div class="d-flex justify-content-between align-items-center section-header">
    <h4 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-cubes text-primary me-2"></i>Job Definitions</h4>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover table-borderless align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Job Name</th>
                    <th>Schedule</th>
                    <th>Policies (K8s)</th>
                    <th>Next Run</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="fa-solid fa-box-open fs-1 mb-3"></i><br />
                            No job specifications found. Register jobs in your code or via DB.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var spec in Model)
                    {
                        <tr>
                            <td class="py-3">
                                <div class="fw-bold text-dark" style="font-size: 0.95rem;">@spec.Name</div>
                                <div class="text-muted" style="font-size: 0.75rem;" title="@spec.Id"><i class="fa-solid fa-fingerprint me-1"></i>@(spec.Id.Length > 8 ? spec.Id.Substring(0, 8) + "..." : spec.Id)</div>
                            </td>
                            <td class="py-3">
                                <span class="badge bg-light text-dark border font-monospace px-2 py-1 mb-1 d-inline-block fw-normal" title="Cron Expression"><i class="fa-regular fa-clock text-muted me-1"></i>@spec.CronExpression</span>
                                <div class="text-muted" style="font-size: 0.8rem;"><i class="fa-solid fa-hourglass-half me-1"></i>Timeout: @spec.TimeoutSeconds s</div>
                            </td>
                            <td class="py-3">
                                <div class="d-flex flex-wrap gap-1 mb-1">
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill fw-normal" title="Execution Model">@spec.ExecuteModel</span>
                                    <span class="badge @(spec.ConcurrencyPolicy == KubeJob.Core.Enums.ConcurrencyPolicy.Allow ? "bg-success bg-opacity-10 text-success border-success" : spec.ConcurrencyPolicy == KubeJob.Core.Enums.ConcurrencyPolicy.Forbid ? "bg-warning bg-opacity-10 text-warning border-warning" : "bg-danger bg-opacity-10 text-danger border-danger") border rounded-pill fw-normal" title="Concurrency Policy">
                                        <i class="fa-solid fa-layer-group me-1"></i>@spec.ConcurrencyPolicy
                                    </span>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill fw-normal" title="Shards"><i class="fa-solid fa-cubes me-1"></i>Shards: @spec.TotalShards</span>
                                </div>
                                <div class="text-muted d-flex align-items-center gap-3 mt-1" style="font-size: 0.8rem;">
                                    <span title="History Limits (Success / Failed)"><i class="fa-solid fa-database me-1"></i>Limits: @spec.SuccessfulJobsHistoryLimit / @spec.FailedJobsHistoryLimit</span>
                                    @if (!string.IsNullOrEmpty(spec.NodeSelector) && spec.NodeSelector != "{}")
                                    {
                                        <span title="Node Selector"><i class="fa-solid fa-tags me-1"></i>@spec.NodeSelector</span>
                                    }
                                </div>
                            </td>
                            <td class="text-muted py-3" style="font-size: 0.9rem;">
                                @if(spec.IsDisabled)
                                {
                                    <span class="text-warning"><i class="fa-solid fa-pause-circle me-1"></i>Paused</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-calendar-days me-1"></i>@(spec.NextRunTime?.ToString("MM-dd HH:mm:ss") ?? "Pending")
                                }
                            </td>
                            <td class="py-3">
                                @if(spec.IsDisabled)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill fw-normal px-2"><i class="fa-solid fa-pause me-1"></i> Paused</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill fw-normal px-2"><i class="fa-solid fa-play me-1"></i> Active</span>
                                }
                            </td>
                            <td class="text-end py-3">
                                <div class="d-flex justify-content-end gap-2">
                                    <form asp-action="TriggerSpec" asp-route-id="@spec.Id" method="post" class="m-0">
                                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" @(spec.IsDisabled ? "disabled" : "") title="Trigger Now">
                                            <i class="fa-solid fa-bolt"></i> Trigger
                                        </button>
                                    </form>
                                    <form asp-action="ToggleSpec" asp-route-id="@spec.Id" method="post" class="m-0">
                                        <input type="hidden" name="isDisabled" value="@(spec.IsDisabled ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm @(spec.IsDisabled ? "btn-outline-success" : "btn-outline-warning") rounded-pill px-3 shadow-sm" style="min-width: 90px;">
                                            @if(spec.IsDisabled)
                                            {
                                                <span><i class="fa-solid fa-play me-1"></i> Resume</span>
                                            }
                                            else
                                            {
                                                <span><i class="fa-solid fa-pause me-1"></i> Pause</span>
                                            }
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 0)
    {
        <div class="d-flex justify-content-between align-items-center mt-4 px-3 pb-3">
            <div class="text-muted small fw-bold d-flex align-items-center gap-3">
                <div>
                    Showing page <span class="text-primary">@ViewBag.CurrentPage</span> of @ViewBag.TotalPages 
                    <span class="ms-2 badge bg-light text-dark border">Total: @ViewBag.TotalCount records</span>
                </div>
                <form id="pageSizeForm" method="get" class="d-flex align-items-center gap-2 m-0">
                    <label for="pageSize" class="mb-0 text-nowrap">Per page:</label>
                    <select name="pageSize" id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="document.getElementById('pageSizeForm').submit()">
                        @foreach(var sz in new[] { 10, 20, 50, 100 })
                        {
                            if (ViewBag.PageSize == sz) {
                                <option value="@sz" selected>@sz</option>
                            } else {
                                <option value="@sz">@sz</option>
                            }
                        }
                    </select>
                    <input type="hidden" name="page" value="1" />
                </form>
            </div>
            <ul class="pagination pagination-sm mb-0 shadow-sm">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&pageSize=@ViewBag.PageSize"><i class="fa-solid fa-chevron-left"></i> Prev</a>
                </li>
                
                @{
                    int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                    int endPage = Math.Min(ViewBag.TotalPages, startPage + 4);
                    if (endPage - startPage < 4) {
                        startPage = Math.Max(1, endPage - 4);
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link" href="?page=@i&pageSize=@ViewBag.PageSize">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&pageSize=@ViewBag.PageSize">Next <i class="fa-solid fa-chevron-right"></i></a>
                </li>
            </ul>
        </div>
    }
</div>