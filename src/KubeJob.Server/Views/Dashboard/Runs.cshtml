@using KubeJob.Core.Domain
@using KubeJob.Core.Enums
@model IEnumerable<JobRun>
@{
    ViewData["Title"] = "Jobs";
    var activeStatus = (JobStatus?)ViewBag.ActiveStatus;
    var counts = (IReadOnlyDictionary<JobStatus, int>)ViewBag.StatusCounts;
    var tabOrder = (IEnumerable<JobStatus>)ViewBag.TabOrder;
    string TabUrl(JobStatus? status) => status.HasValue
        ? Url.Action("Runs", new { status = status.Value.ToString(), pageSize = ViewBag.PageSize })!
        : Url.Action("Runs", new { pageSize = ViewBag.PageSize })!;
    string PageUrl(int page) => Url.Action("Runs", new { status = activeStatus?.ToString(), page, pageSize = ViewBag.PageSize })!;
}

@section PageActions {
    <button class="kj-btn kj-btn-outline" type="button" onclick="location.reload()">Refresh</button>
}

<nav class="kj-tabs" aria-label="Job status">
    <a class="kj-tab @(!activeStatus.HasValue ? "active" : "")" href="@TabUrl(null)">All <span class="kj-tab-count">@ViewBag.AllRunsCount</span></a>
    @foreach (var status in tabOrder)
    {
        <a class="kj-tab @(activeStatus == status ? "active" : "")" href="@TabUrl(status)">@status <span class="kj-tab-count">@counts[status]</span></a>
    }
</nav>

<section class="kj-card">
    <div class="kj-table-wrap">
        <table class="kj-table">
            <thead><tr><th>Id</th><th>Job / shard</th><th>Server</th><th>Status</th><th>Created</th><th class="kj-number">Duration</th><th></th></tr></thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="kj-empty">No jobs match this status.</td></tr>
            }
            else
            {
                @foreach (var run in Model)
                {
                    var rowId = $"run-detail-{run.Id}";
                    var duration = run.StartTime.HasValue && run.EndTime.HasValue ? $"{(run.EndTime.Value - run.StartTime.Value).TotalSeconds:0.0}s" : "-";
                    <tr>
                        <td><div class="kj-mono">@run.Id[..Math.Min(8, run.Id.Length)]</div><div class="kj-muted kj-mono">@((run.BatchId ?? "-")[..Math.Min(8, (run.BatchId ?? "-").Length)])</div></td>
                        <td><div>@run.SpecId</div><div class="kj-muted">Shard @run.ShardIndex</div></td>
                        <td>@(run.TargetNodeId ?? "-")</td>
                        <td><span class="kj-pill status-@run.Status.ToString().ToLowerInvariant()">@run.Status</span></td>
                        <td>@run.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="kj-number">@duration</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(run.ResultMsg))
                            {
                                <button type="button" class="kj-btn kj-btn-link" data-kj-toggle-log="@rowId" aria-expanded="false">Details</button>
                            }
                        </td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(run.ResultMsg))
                    {
                        <tr id="@rowId" class="kj-expand-row" hidden><td colspan="7"><pre class="kj-log">@run.ResultMsg</pre></td></tr>
                    }
                }
            }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 0)
    {
        <div class="kj-pagination">
            <span class="kj-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages · @ViewBag.TotalCount jobs</span>
            <form class="kj-page-size" method="get">
                @if (activeStatus.HasValue) { <input type="hidden" name="status" value="@activeStatus.Value" /> }
                <input type="hidden" name="page" value="1" />
                <label class="kj-muted" for="pageSize">Rows</label>
                <select id="pageSize" name="pageSize" onchange="this.form.submit()">
                    @foreach (var size in new[] { 10, 20, 50, 100 }) { <option value="@size" selected="@(ViewBag.PageSize == size ? "selected" : null)">@size</option> }
                </select>
            </form>
            <div class="kj-page-links">
                @if (ViewBag.CurrentPage > 1) { <a href="@PageUrl(ViewBag.CurrentPage - 1)">Prev</a> } else { <span>Prev</span> }
                @for (var i = Math.Max(1, (int)ViewBag.CurrentPage - 2); i <= Math.Min((int)ViewBag.TotalPages, (int)ViewBag.CurrentPage + 2); i++)
                {
                    if (i == ViewBag.CurrentPage) { <span class="active">@i</span> } else { <a href="@PageUrl(i)">@i</a> }
                }
                @if (ViewBag.CurrentPage < ViewBag.TotalPages) { <a href="@PageUrl(ViewBag.CurrentPage + 1)">Next</a> } else { <span>Next</span> }
            </div>
        </div>
    }
</section>

<script>
document.addEventListener("click", event => {
    const button = event.target.closest("[data-kj-toggle-log]");
    if (!button) return;
    const row = document.getElementById(button.dataset.kjToggleLog);
    if (!row) return;
    row.hidden = !row.hidden;
    button.setAttribute("aria-expanded", String(!row.hidden));
    button.textContent = row.hidden ? "Details" : "Hide details";
});
</script>
