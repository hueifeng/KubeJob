@model DashboardRunsViewModel
@{
    ViewData["Title"] = "Runs & Attempts";
    var page = Model.Runs;
    var query = Model.Query;
}
<meta http-equiv="refresh" content="30">

<div class="section-header">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h5 class="mb-1 fw-bold">Logical job runs</h5>
            <div class="small text-muted">Filter by phase, queue, or stable job key. Open a Run to inspect its Attempts.</div>
        </div>
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small mb-1">Phase</label>
                <select name="phase" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var phase in Enum.GetValues<JobPhase>())
                    {
                        if (query.Phase == phase)
                        {
                            <option value="@phase" selected>@phase</option>
                        }
                        else
                        {
                            <option value="@phase">@phase</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Queue</label>
                <input name="queue" value="@query.Queue" class="form-control form-control-sm" placeholder="default" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Job key</label>
                <input name="jobKey" value="@query.JobKey" class="form-control form-control-sm" placeholder="mail.send" />
            </div>
            <input type="hidden" name="pageSize" value="@query.PageSize" />
            <div class="col-auto"><button class="btn btn-sm btn-primary"><i class="fa-solid fa-filter me-1"></i>Apply</button></div>
        </form>
    </div>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Run</th><th>Job / Queue</th><th>Phase</th><th>Worker</th><th>Attempts</th><th>Timing</th><th>Failure</th></tr></thead>
            <tbody>
            @if (page.Items.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-5">No runs match the current filters.</td></tr>
            }
            else
            {
                @foreach (var run in page.Items)
                {
                    var badge = run.Phase switch
                    {
                        JobPhase.Succeeded => "bg-success-subtle text-success",
                        JobPhase.Running => "bg-primary-subtle text-primary",
                        JobPhase.Pending => "bg-warning-subtle text-warning-emphasis",
                        JobPhase.Canceled => "bg-secondary-subtle text-secondary",
                        JobPhase.Dead => "bg-dark-subtle text-dark",
                        _ => "bg-danger-subtle text-danger"
                    };
                    var duration = run.StartedAt is null
                        ? null
                        : ((run.CompletedAt ?? DateTimeOffset.UtcNow) - run.StartedAt.Value);
                    <tr>
                        <td>
                            <a asp-action="Run" asp-route-id="@run.Id" class="mono fw-semibold text-decoration-none">@run.Id[..Math.Min(12, run.Id.Length)]</a>
                            @if (run.ScheduleId is not null)
                            {
                                <div class="small text-muted">schedule: @run.ScheduleId</div>
                            }
                        </td>
                        <td><div class="fw-semibold">@run.JobKey</div><span class="badge bg-light text-dark border">@run.Queue</span> <span class="small text-muted">priority @run.Priority</span></td>
                        <td><span class="badge @badge">@run.Phase</span>@if (run.CancelRequested){<div class="small text-danger mt-1">cancel requested</div>}</td>
                        <td>
                            @if (run.CurrentWorkerId is null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <div class="mono small">@run.CurrentWorkerId</div><div class="small text-muted">@run.CurrentSessionId</div>
                            }
                        </td>
                        <td>@run.AttemptCount / @run.MaxAttempts</td>
                        <td class="small text-muted">
                            <div>@run.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</div>
                            @if (duration is not null)
                            {
                                <div>@duration.Value.TotalSeconds.ToString("0.0")s</div>
                            }
                        </td>
                        <td>
                            @if (run.FailureCode is null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <div class="text-danger small fw-semibold">@run.FailureCode</div>
                                <div class="small text-muted text-truncate" style="max-width: 220px" title="@run.FailureMessage">@run.FailureMessage</div>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 p-3 border-top">
        <div class="small text-muted">@page.TotalCount runs · page @page.Page of @(Math.Max(1, page.TotalPages))</div>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-secondary @(page.Page <= 1 ? "disabled" : "")"
               asp-action="Runs" asp-route-page="@(page.Page - 1)" asp-route-pageSize="@page.PageSize"
               asp-route-phase="@query.Phase" asp-route-queue="@query.Queue" asp-route-jobKey="@query.JobKey">Previous</a>
            <a class="btn btn-sm btn-outline-secondary @(page.TotalPages == 0 || page.Page >= page.TotalPages ? "disabled" : "")"
               asp-action="Runs" asp-route-page="@(page.Page + 1)" asp-route-pageSize="@page.PageSize"
               asp-route-phase="@query.Phase" asp-route-queue="@query.Queue" asp-route-jobKey="@query.JobKey">Next</a>
        </div>
    </div>
</div>
