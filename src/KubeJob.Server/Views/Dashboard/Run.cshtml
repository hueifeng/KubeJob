@using System.Text.Json
@model DashboardRunDetailsViewModel
@{
    ViewData["Title"] = "Job Details";
    var run = Model.Run;
    string? payload = null;
    if (Model.ShowPayload && run.PayloadJson is not null)
    {
        try
        {
            using var document = JsonDocument.Parse(run.PayloadJson);
            payload = JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            payload = run.PayloadJson;
        }
    }
    var runBadge = run.Phase switch
    {
        JobPhase.Succeeded => "bg-success-subtle text-success",
        JobPhase.Running => "bg-primary-subtle text-primary",
        JobPhase.Pending => "bg-warning-subtle text-warning-emphasis",
        JobPhase.Canceled => "bg-secondary-subtle text-secondary",
        JobPhase.Dead => "bg-dark-subtle text-dark",
        _ => "bg-danger-subtle text-danger"
    };
    var runStatus = run.Phase switch
    {
        JobPhase.Pending => "Waiting",
        JobPhase.Running => "Running",
        JobPhase.Succeeded => "Succeeded",
        JobPhase.Failed => "Permanent failure",
        JobPhase.Canceled => "Canceled",
        JobPhase.Dead => "No retries left",
        _ => run.Phase.ToString()
    };
}

<div class="section-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <a asp-action="Runs" class="small text-decoration-none"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Back to jobs</a>
        <h2 class="mb-1 mt-2 fw-bold mono">@run.Id</h2>
        <div class="text-muted small">Job type <strong>@run.JobKey</strong> · queue <strong>@run.Queue</strong></div>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (run.Phase is JobPhase.Failed or JobPhase.Dead)
        {
            <a asp-action="Failures" class="btn btn-sm btn-outline-danger">Failure workbench</a>
        }
        <span class="badge @runBadge fs-6" title="KubeJob phase: @run.Phase">@runStatus</span>
        @if (Model.AllowMutatingActions && run.Phase is JobPhase.Pending or JobPhase.Running)
        {
            <form asp-action="CancelRun" asp-route-id="@run.Id" method="post" onsubmit="return confirm('Request cooperative cancellation for this job? A running handler must observe its cancellation token before it stops.');">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-danger" title="Request cooperative cancellation"><i class="fa-solid fa-ban me-1" aria-hidden="true"></i>Request cancellation</button>
            </form>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="detail-card p-4 h-100">
            <h6 class="fw-bold mb-1">Job run</h6>
            <div class="small text-muted mb-3">A Run is one logical job. Retries and reassignments appear as separate Attempts below.</div>
            <div class="row key-value">
                <div class="col-md-4"><dt>Job type (key)</dt><dd>@run.JobKey</dd></div>
                <div class="col-md-4"><dt>Queue / priority</dt><dd>@run.Queue / @run.Priority</dd></div>
                <div class="col-md-4"><dt>Attempts used</dt><dd>@run.AttemptCount of @run.MaxAttempts</dd></div>
                <div class="col-md-4"><dt>Submitted</dt><dd>@run.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")</dd></div>
                <div class="col-md-4"><dt>Ready to run from</dt><dd>@run.AvailableAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")</dd></div>
                <div class="col-md-4"><dt>Maximum execution time</dt><dd>@run.TimeoutSeconds seconds</dd></div>
                <div class="col-md-4"><dt>Started</dt><dd>@(run.StartedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz") ?? "Not started")</dd></div>
                <div class="col-md-4"><dt>Completed</dt><dd>@(run.CompletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz") ?? "Not completed")</dd></div>
                <div class="col-md-4"><dt>Current worker</dt><dd>@(run.CurrentWorkerId ?? "Not assigned")</dd></div>
                <div class="col-md-6"><dt>Idempotency key</dt><dd class="mono">@(run.IdempotencyKey ?? "Not set")</dd></div>
                <div class="col-md-6"><dt>Concurrency key</dt><dd class="mono">@(run.ConcurrencyKey ?? "Not set")</dd></div>
                <div class="col-md-6">
                    <dt>Ordering</dt>
                    <dd>
                        @if (run.OrderingMode == ExecutionOrderingMode.KeyOrdered)
                        {
                            <span>KeyOrdered · sequence @run.OrderingSequence</span>
                            @if (run.Phase == JobPhase.Pending && !string.IsNullOrEmpty(run.ConcurrencyKey))
                            {
                                <div class="small text-muted">Waits for earlier same-key runs on this queue to finish before it can be claimed.</div>
                            }
                        }
                        else if (run.OrderingMode == ExecutionOrderingMode.StrictFifo)
                        {
                            <span>StrictFifo · sequence @run.OrderingSequence</span>
                            <span class="small text-muted ms-1">(lane-global ordering with single active consumer)</span>
                            @if (run.Phase == JobPhase.Pending)
                            {
                                <div class="small text-muted">The entire lane is serialized; this run waits for all earlier runs to finish.</div>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Parallel (no ordering constraint)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(run.BlockedReason))
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis ms-2" title="@run.BlockedReason">BLOCKED</span>
                        }
                    </dd>
                </div>
                <div class="col-md-6"><dt>Created by schedule</dt><dd>@(run.ScheduleId ?? "No")</dd></div>
                <div class="col-md-6"><dt>Scheduled occurrence</dt><dd>@(run.ScheduledFor?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz") ?? "Not scheduled")</dd></div>
            </div>
            @if (run.CancelRequested && run.Phase is JobPhase.Pending or JobPhase.Running)
            {
                <div class="alert alert-secondary mb-3"><strong>Cancellation requested.</strong> A running job stops only after its handler observes the cancellation token.</div>
            }
            @if (run.FailureCode is not null)
            {
                <div class="alert alert-danger mb-0">
                    <strong>Latest error: @run.FailureCode</strong>
                    <div class="mt-1" style="white-space: pre-wrap">@run.FailureMessage</div>
                    @if (run.Phase == JobPhase.Failed)
                    {
                        <div class="mt-2 small">The handler marked this as permanent, so KubeJob did not schedule another Attempt.</div>
                    }
                    else if (run.Phase == JobPhase.Dead)
                    {
                        <div class="mt-2 small">This job has no retries left. Review the Attempt history before submitting it again.</div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="detail-card p-4 h-100">
            <h6 class="fw-bold mb-1">Submitted data (payload)</h6>
            <div class="small text-muted mb-3">The serialized input supplied when this job was submitted.</div>
            @if (Model.ShowPayload && payload is not null)
            {
                <div class="small text-muted mb-2">Payload display is enabled by the host. Treat this data as sensitive.</div>
                <pre class="payload mb-0">@payload</pre>
            }
            else if (Model.ShowPayload)
            {
                <div class="alert alert-secondary mb-0">Payload was not returned by the dashboard query service.</div>
            }
            else
            {
                <div class="alert alert-secondary mb-0">
                    <i class="fa-solid fa-eye-slash me-2" aria-hidden="true"></i>
                    Payload display is disabled. Set <code>ShowPayloads = true</code> only for a protected dashboard.
                </div>
            }
        </div>
    </div>
</div>

<section class="panel mb-4">
    <div class="panel-header">
        <div>
            <h2>Execution timeline</h2>
            <div class="panel-subtitle">A chronological view of submission, worker claims, attempt outcomes, and scheduled retries.</div>
        </div>
        <span class="badge bg-light text-dark border">@Model.Timeline.Count events</span>
    </div>
    <div>
        @foreach (var item in Model.Timeline)
        {
            var marker = item.Tone switch
            {
                "success" => "bg-success",
                "danger" => "bg-danger-subtle text-danger",
                "warning" => "bg-warning-subtle text-warning-emphasis",
                "primary" => "bg-primary",
                _ => "bg-secondary-subtle text-secondary"
            };
            <div class="d-flex gap-3 p-3 border-bottom">
                <div class="small text-muted mono" style="width: 150px; flex: none;">@item.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                <div style="width: 14px; flex: none; padding-top: 4px;">
                    <span class="badge @marker" style="width: 10px; min-height: 10px; height: 10px; padding: 0;" aria-hidden="true"></span>
                </div>
                <div style="min-width: 0;">
                    <div class="fw-semibold">@item.Title</div>
                    <div class="small text-muted mt-1" style="white-space: pre-wrap; word-break: break-word;">@item.Detail</div>
                </div>
            </div>
        }
    </div>
</section>

<div class="section-header">
    <h2 class="mb-1 fw-bold">Execution attempts</h2>
    <div class="small text-muted">Each retry or worker reassignment creates a new Attempt. Lease credentials are never shown.</div>
</div>
<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th scope="col">Try</th><th scope="col">Attempt ID</th><th scope="col">Worker session</th><th scope="col">Status</th><th scope="col">Started / finished</th><th scope="col">Lease valid until</th><th scope="col">Error</th></tr></thead>
            <tbody>
            @if (Model.Attempts.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-5">No worker has started this job yet.</td></tr>
            }
            else
            {
                @foreach (var attempt in Model.Attempts.OrderByDescending(item => item.AttemptNumber))
                {
                    var attemptBadge = attempt.Phase switch
                    {
                        JobAttemptPhase.Succeeded => "bg-success-subtle text-success",
                        JobAttemptPhase.Running => "bg-primary-subtle text-primary",
                        JobAttemptPhase.Canceled => "bg-secondary-subtle text-secondary",
                        JobAttemptPhase.LeaseLost => "bg-warning-subtle text-warning-emphasis",
                        _ => "bg-danger-subtle text-danger"
                    };
                    var attemptStatus = attempt.Phase switch
                    {
                        JobAttemptPhase.Running => "Running",
                        JobAttemptPhase.Succeeded => "Succeeded",
                        JobAttemptPhase.RetryableFailure => "Failed; retry allowed",
                        JobAttemptPhase.PermanentFailure => "Permanent failure",
                        JobAttemptPhase.Canceled => "Canceled",
                        JobAttemptPhase.TimedOut => "Timed out",
                        JobAttemptPhase.LeaseLost => "Worker lease lost",
                        JobAttemptPhase.Rejected => "Result rejected",
                        _ => attempt.Phase.ToString()
                    };
                    <tr>
                        <td class="fw-bold">@attempt.AttemptNumber</td>
                        <td class="mono small">@attempt.Id</td>
                        <td><div class="fw-semibold">@attempt.WorkerId</div><div class="mono small text-muted" title="Session ID and fencing epoch">@attempt.SessionId / epoch @attempt.SessionEpoch</div></td>
                        <td><span class="badge @attemptBadge" title="KubeJob Attempt phase: @attempt.Phase">@attemptStatus</span></td>
                        <td class="small text-muted"><div>@attempt.ClaimedAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</div><div>@(attempt.CompletedAt?.ToLocalTime().ToString("MM-dd HH:mm:ss") ?? "Still running")</div></td>
                        <td class="small @(attempt.Phase == JobAttemptPhase.Running && attempt.LeaseExpiresAt <= DateTimeOffset.UtcNow ? "text-danger fw-semibold" : "text-muted")">@attempt.LeaseExpiresAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</td>
                        <td>
                            @if (attempt.FailureCode is null)
                            {
                                <span class="text-muted">No error</span>
                            }
                            else
                            {
                                <div class="text-danger fw-semibold small">@attempt.FailureCode</div>
                                <div class="small text-muted" style="white-space: pre-wrap">@attempt.FailureMessage</div>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
