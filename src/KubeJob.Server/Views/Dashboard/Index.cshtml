@model DashboardIndexViewModel
@{
    ViewData["Title"] = "Runtime Overview";
    var overview = Model.Overview;

    static string FormatAge(TimeSpan value)
    {
        var age = value < TimeSpan.Zero ? TimeSpan.Zero : value;
        if (age.TotalDays >= 1)
        {
            return $"{(int)age.TotalDays}d {age.Hours}h";
        }

        if (age.TotalHours >= 1)
        {
            return $"{(int)age.TotalHours}h {age.Minutes}m";
        }

        if (age.TotalMinutes >= 1)
        {
            return $"{(int)age.TotalMinutes}m {age.Seconds}s";
        }

        return $"{Math.Floor(age.TotalSeconds):0}s";
    }
}
<meta http-equiv="refresh" content="20">

<div class="metric-grid">
    <section class="metric-card">
        <div class="metric-head"><span>Active runs</span><span class="metric-glyph">↗</span></div>
        <div class="metric-value">@(overview.PendingRuns + overview.RunningRuns)</div>
        <div class="metric-detail">
            <span><strong>@overview.PendingRuns</strong> pending</span>
            <span><strong>@overview.RunningRuns</strong> running</span>
        </div>
    </section>
    <section class="metric-card">
        <div class="metric-head"><span>Worker capacity</span><span class="metric-glyph">▤</span></div>
        <div class="metric-value">@overview.AvailableWorkerSlots<small>/ @overview.TotalWorkerCapacity</small></div>
        <div class="metric-detail">
            <span><strong>@overview.ReadyWorkers</strong> ready</span>
            <span><strong>@overview.DrainingWorkers</strong> draining</span>
        </div>
    </section>
    <section class="metric-card">
        <div class="metric-head"><span>Completed · 1 hour</span><span class="metric-glyph">✓</span></div>
        <div class="metric-value">@overview.LastHour.CompletedRuns</div>
        <div class="metric-detail">
            <span><strong class="text-success">@overview.LastHour.SucceededRuns</strong> succeeded</span>
            <span><strong>@overview.LastHour.CanceledRuns</strong> canceled</span>
        </div>
    </section>
    <section class="metric-card">
        <div class="metric-head"><span>Unsuccessful · 1 hour</span><span class="metric-glyph">!</span></div>
        <div class="metric-value text-danger">@overview.LastHour.UnsuccessfulRuns</div>
        <div class="metric-detail">
            <span><strong>@overview.LastHour.FailedRuns</strong> failed</span>
            <span><strong>@overview.LastHour.DeadRuns</strong> dead</span>
        </div>
    </section>
</div>

<div class="dashboard-grid">
    <section class="panel">
        <div class="panel-header">
            <div>
                <h5>Queue backlog</h5>
                <div class="panel-subtitle">Active logical runs and the oldest Pending Run that is ready to claim.</div>
            </div>
            <a asp-action="Runs" class="btn btn-sm btn-outline-primary">Open runs</a>
        </div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead><tr><th>Queue</th><th>Pending</th><th>Running</th><th>Oldest ready</th><th class="text-end">Active</th></tr></thead>
                <tbody>
                @if (overview.Queues.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">No active queue backlog.</td></tr>
                }
                else
                {
                    @foreach (var queue in overview.Queues)
                    {
                        <tr>
                            <td><a asp-action="Runs" asp-route-queue="@queue.Queue" class="fw-semibold text-decoration-none">@queue.Queue</a></td>
                            <td><span class="badge bg-warning-subtle text-warning-emphasis">@queue.PendingRuns</span></td>
                            <td><span class="badge bg-primary-subtle text-primary">@queue.RunningRuns</span></td>
                            <td class="small">
                                @if (queue.OldestReadyAt is null)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    var age = overview.ObservedAt - queue.OldestReadyAt.Value;
                                    <span class="@(age >= TimeSpan.FromMinutes(5) ? "text-danger fw-semibold" : "text-muted")"
                                          title="@queue.OldestReadyAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")">@FormatAge(age)</span>
                                }
                            </td>
                            <td class="text-end fw-bold">@queue.ActiveRuns</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <div>
                <h5>Runtime signals</h5>
                <div class="panel-subtitle">Snapshot @overview.ObservedAt.ToLocalTime().ToString("HH:mm:ss zzz").</div>
            </div>
        </div>
        <ul class="signal-list">
            <li class="signal-item"><span class="signal-label">Outbox pending</span><span class="signal-value">@overview.PendingOutboxMessages</span></li>
            <li class="signal-item"><span class="signal-label">Schedules enabled</span><span class="signal-value">@overview.EnabledSchedules</span></li>
            <li class="signal-item"><span class="signal-label">Schedules disabled</span><span class="signal-value">@overview.DisabledSchedules</span></li>
            <li class="signal-item"><span class="signal-label">Lifetime succeeded</span><span class="signal-value text-success">@overview.SucceededRuns</span></li>
            <li class="signal-item"><span class="signal-label">Lifetime failed / dead</span><span class="signal-value text-danger">@(overview.FailedRuns + overview.DeadRuns)</span></li>
        </ul>
    </section>
</div>

<section class="panel">
    <div class="panel-header">
        <div>
            <h5>Recent runs</h5>
            <div class="panel-subtitle">Retries remain grouped under the same logical run.</div>
        </div>
        <a asp-action="Runs" class="btn btn-sm btn-outline-primary">View all</a>
    </div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead><tr><th>Run</th><th>Job</th><th>Queue</th><th>Phase</th><th>Attempts</th><th>Created</th></tr></thead>
            <tbody>
            @if (overview.RecentRuns.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-5">No runs have been submitted.</td></tr>
            }
            else
            {
                @foreach (var run in overview.RecentRuns)
                {
                    var badge = run.Phase switch
                    {
                        JobPhase.Succeeded => "bg-success-subtle text-success",
                        JobPhase.Running => "bg-primary-subtle text-primary",
                        JobPhase.Pending => "bg-warning-subtle text-warning-emphasis",
                        JobPhase.Canceled => "bg-secondary-subtle text-secondary",
                        JobPhase.Dead => "bg-dark-subtle text-dark",
                        _ => "bg-danger-subtle text-danger"
                    };
                    <tr>
                        <td><a asp-action="Run" asp-route-id="@run.Id" class="mono fw-semibold text-decoration-none">@run.Id[..Math.Min(10, run.Id.Length)]</a></td>
                        <td class="fw-semibold">@run.JobKey</td>
                        <td><span class="badge bg-light text-dark border">@run.Queue</span></td>
                        <td><span class="badge @badge">@run.Phase</span></td>
                        <td>@run.AttemptCount / @run.MaxAttempts</td>
                        <td class="text-muted small">@run.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
