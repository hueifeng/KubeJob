@model DashboardIndexViewModel
@{
    ViewData["Title"] = "Runtime overview";
    var overview = Model.Overview;
}
<meta http-equiv="refresh" content="20">

<div class="metric-grid">
    <section class="metric-card">
        <div class="metric-head"><span>Active runs</span><span class="metric-glyph">↗</span></div>
        <div class="metric-value">@(overview.PendingRuns + overview.RunningRuns)</div>
        <div class="metric-detail">
            <span><strong>@overview.PendingRuns</strong> pending</span>
            <span><strong>@overview.RunningRuns</strong> running</span>
        </div>
    </section>
    <section class="metric-card">
        <div class="metric-head"><span>Worker capacity</span><span class="metric-glyph">▤</span></div>
        <div class="metric-value">@overview.AvailableWorkerSlots<small>/ @overview.TotalWorkerCapacity</small></div>
        <div class="metric-detail">
            <span><strong>@overview.ReadyWorkers</strong> ready</span>
            <span><strong>@overview.DrainingWorkers</strong> draining</span>
        </div>
    </section>
    <section class="metric-card">
        <div class="metric-head"><span>Schedules</span><span class="metric-glyph">□</span></div>
        <div class="metric-value">@overview.EnabledSchedules</div>
        <div class="metric-detail">
            <span><strong>@overview.DisabledSchedules</strong> disabled</span>
        </div>
    </section>
    <section class="metric-card">
        <div class="metric-head"><span>Terminal failures</span><span class="metric-glyph">!</span></div>
        <div class="metric-value">@(overview.FailedRuns + overview.DeadRuns)</div>
        <div class="metric-detail">
            <span><strong>@overview.FailedRuns</strong> failed</span>
            <span><strong>@overview.DeadRuns</strong> dead</span>
        </div>
    </section>
</div>

<div class="dashboard-grid">
    <section class="panel">
        <div class="panel-header">
            <div>
                <h5>Queue backlog</h5>
                <div class="panel-subtitle">Active logical runs grouped by submission queue.</div>
            </div>
            <a asp-action="Runs" class="btn btn-sm btn-outline-primary">Open runs</a>
        </div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead><tr><th>Queue</th><th>Pending</th><th>Running</th><th class="text-end">Active</th></tr></thead>
                <tbody>
                @if (overview.Queues.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-5">No active queue backlog.</td></tr>
                }
                else
                {
                    @foreach (var queue in overview.Queues)
                    {
                        <tr>
                            <td><a asp-action="Runs" asp-route-queue="@queue.Queue" class="fw-semibold text-decoration-none">@queue.Queue</a></td>
                            <td><span class="badge bg-warning-subtle text-warning-emphasis">@queue.PendingRuns</span></td>
                            <td><span class="badge bg-primary-subtle text-primary">@queue.RunningRuns</span></td>
                            <td class="text-end fw-bold">@queue.ActiveRuns</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <div>
                <h5>Runtime signals</h5>
                <div class="panel-subtitle">Current operational totals.</div>
            </div>
        </div>
        <ul class="signal-list">
            <li class="signal-item"><span class="signal-label">Outbox pending</span><span class="signal-value">@overview.PendingOutboxMessages</span></li>
            <li class="signal-item"><span class="signal-label">Succeeded runs</span><span class="signal-value text-success">@overview.SucceededRuns</span></li>
            <li class="signal-item"><span class="signal-label">Canceled runs</span><span class="signal-value">@overview.CanceledRuns</span></li>
            <li class="signal-item"><span class="signal-label">Ready workers</span><span class="signal-value">@overview.ReadyWorkers</span></li>
            <li class="signal-item"><span class="signal-label">Total terminal</span><span class="signal-value">@(overview.SucceededRuns + overview.FailedRuns + overview.CanceledRuns + overview.DeadRuns)</span></li>
        </ul>
    </section>
</div>

<section class="panel">
    <div class="panel-header">
        <div>
            <h5>Recent runs</h5>
            <div class="panel-subtitle">Retries remain grouped under the same logical run.</div>
        </div>
        <a asp-action="Runs" class="btn btn-sm btn-outline-primary">View all</a>
    </div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead><tr><th>Run</th><th>Job</th><th>Queue</th><th>Phase</th><th>Attempts</th><th>Created</th></tr></thead>
            <tbody>
            @if (overview.RecentRuns.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-5">No runs have been submitted.</td></tr>
            }
            else
            {
                @foreach (var run in overview.RecentRuns)
                {
                    var badge = run.Phase switch
                    {
                        JobPhase.Succeeded => "bg-success-subtle text-success",
                        JobPhase.Running => "bg-primary-subtle text-primary",
                        JobPhase.Pending => "bg-warning-subtle text-warning-emphasis",
                        JobPhase.Canceled => "bg-secondary-subtle text-secondary",
                        JobPhase.Dead => "bg-dark-subtle text-dark",
                        _ => "bg-danger-subtle text-danger"
                    };
                    <tr>
                        <td><a asp-action="Run" asp-route-id="@run.Id" class="mono fw-semibold text-decoration-none">@run.Id[..Math.Min(10, run.Id.Length)]</a></td>
                        <td class="fw-semibold">@run.JobKey</td>
                        <td><span class="badge bg-light text-dark border">@run.Queue</span></td>
                        <td><span class="badge @badge">@run.Phase</span></td>
                        <td>@run.AttemptCount / @run.MaxAttempts</td>
                        <td class="text-muted small">@run.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>