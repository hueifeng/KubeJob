@model DashboardIndexViewModel
@{
    ViewData["Title"] = "Runtime Overview";
    var overview = Model.Overview;
    var activeRuns = overview.PendingRuns + overview.RunningRuns;
    var operational = DashboardOperationalSummary.Create(overview);
}

<style>
    .overview-summary {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
        padding: 14px 16px;
        border: 1px solid var(--border);
        border-left-width: 4px;
        border-radius: 6px;
        background: var(--surface);
        box-shadow: var(--shadow);
    }
    .overview-summary.success { border-left-color: var(--success); background: #fbfefb; }
    .overview-summary.warning { border-left-color: #d18b00; background: #fffdf7; }
    .overview-summary.danger { border-left-color: var(--danger); background: #fffafb; }
    .overview-summary.neutral { border-left-color: var(--secondary); }
    .overview-summary-icon {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border: 1px solid var(--border-strong);
        border-radius: 50%;
        background: white;
        font-size: 15px;
        font-weight: 700;
    }
    .overview-summary-title { font-size: 15px; font-weight: 650; }
    .overview-summary-detail { margin-top: 2px; color: var(--muted); font-size: 12px; }
    .metric-explainer { margin-top: 8px; color: var(--muted); font-size: 11px; line-height: 1.35; }
    .term-help { color: var(--muted); font-size: 12px; }
    .term-help strong { color: var(--text); }
    .idle-readiness { padding: 18px; margin-bottom: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; }
    .idle-readiness h2 { margin: 0 0 4px; font-size: 15px; }
    .idle-readiness p { margin: 0; color: var(--muted); font-size: 12px; }
    .idle-readiness-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 16px; }
    .idle-readiness-item { padding: 12px; background: var(--surface-subtle); border: 1px solid var(--border); border-radius: 4px; }
    .idle-readiness-label { display: block; color: var(--muted); font-size: 11px; font-weight: 600; }
    .idle-readiness-value { display: block; margin-top: 4px; font-size: 20px; font-weight: 650; }
    .attention-panel { margin: 0 0 24px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
    .attention-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 13px 16px; border-bottom: 1px solid var(--border); }
    .attention-header h2 { margin: 0; font-size: 15px; font-weight: 650; }
    .attention-header p { margin: 2px 0 0; color: var(--muted); font-size: 12px; }
    .attention-count { color: var(--danger); font-size: 12px; font-weight: 650; }
    .attention-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 1px; background: var(--border); }
    .attention-item { min-height: 104px; padding: 16px; background: var(--surface); }
    .attention-item.critical { box-shadow: inset 3px 0 0 var(--danger); }
    .attention-item.warning { box-shadow: inset 3px 0 0 #d18b00; }
    .attention-item-title { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 650; }
    .attention-item-title .status-dot { margin: 0; }
    .attention-item-detail { margin: 5px 0 11px; color: var(--muted); font-size: 12px; line-height: 1.4; }
    .attention-item .btn { min-height: 27px; }
    .shortcut-list { margin: 0; padding: 5px 16px; list-style: none; }
    .shortcut-item { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 58px; border-bottom: 1px solid #ededed; }
    .shortcut-item:last-child { border-bottom: 0; }
    .shortcut-item a { font-weight: 650; text-decoration: none; }
    .shortcut-detail { display: block; margin-top: 2px; color: var(--muted); font-size: 12px; }
    @@media (max-width: 760px) {
        .overview-summary { grid-template-columns: auto minmax(0, 1fr); }
        .overview-summary .btn { grid-column: 1 / -1; width: 100%; }
        .idle-readiness-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .attention-grid { grid-template-columns: 1fr; }
    }
</style>

<section class="overview-summary @operational.Message.Tone" aria-label="Operational summary">
    <div class="overview-summary-icon" aria-hidden="true">@operational.Message.Icon</div>
    <div>
        <div class="overview-summary-title">@operational.Message.Title</div>
        <div class="overview-summary-detail">@operational.Message.Detail</div>
    </div>
    @if (operational.Message.Action is not null && operational.Message.ActionRoute is not null)
    {
        <a asp-action="@operational.Message.ActionRoute" class="btn btn-sm btn-outline-primary">@operational.Message.Action</a>
    }
</section>

@if (operational.HasAttention)
{
    <section class="attention-panel" aria-labelledby="attention-title">
        <div class="attention-header">
            <div>
                <h2 id="attention-title">Needs attention</h2>
                <p>Signals that may need an operator action now.</p>
            </div>
            <span class="attention-count">Operator review recommended</span>
        </div>
        <div class="attention-grid">
            @if (operational.WaitingWithoutCapacity)
            {
                <article class="attention-item @(overview.ReadyWorkers == 0 ? "critical" : "warning")">
                    <div class="attention-item-title"><span class="status-dot @(overview.ReadyWorkers == 0 ? "bg-danger" : "bg-warning")" aria-hidden="true"></span>Waiting jobs have no available capacity</div>
                    <div class="attention-item-detail">@overview.PendingRuns job(s) are waiting while @(overview.ReadyWorkers == 0 ? "no Worker is ready" : "all Ready Worker slots remain occupied").</div>
                    <a asp-action="Workers" class="btn btn-sm btn-outline-danger">Inspect workers</a>
                </article>
            }
            @if (operational.HasAgingBacklog)
            {
                <article class="attention-item warning">
                    <div class="attention-item-title"><span class="status-dot bg-warning" aria-hidden="true"></span>Ready work is aging</div>
                    <div class="attention-item-detail">The oldest claimable job has waited @DashboardOperationalSummary.FormatAge(operational.OldestReadyAge!.Value). Check queue coverage and Worker capacity.</div>
                    <a asp-action="Runs" class="btn btn-sm btn-outline-warning">Open queue backlog</a>
                </article>
            }
            @if (operational.HasRecentFailures)
            {
                <article class="attention-item warning">
                    <div class="attention-item-title"><span class="status-dot bg-warning" aria-hidden="true"></span>Recent jobs need review</div>
                    <div class="attention-item-detail">@overview.LastHour.UnsuccessfulRuns job(s) failed or exhausted retries in the last hour.</div>
                    <a asp-action="Failures" class="btn btn-sm btn-outline-warning">Review failures</a>
                </article>
            }
        </div>
    </section>
}

@if (operational.IsIdle)
{
    <section class="idle-readiness" aria-labelledby="runtime-readiness-title">
        <h2 id="runtime-readiness-title">Runtime readiness</h2>
        <p>No triage is needed. Submit a job from your application to begin observing queue activity, execution attempts, and failures here.</p>
        <div class="idle-readiness-grid">
            <div class="idle-readiness-item"><span class="idle-readiness-label">Ready workers</span><span class="idle-readiness-value">@overview.ReadyWorkers</span></div>
            <div class="idle-readiness-item"><span class="idle-readiness-label">Available slots</span><span class="idle-readiness-value">@overview.AvailableWorkerSlots</span></div>
            <div class="idle-readiness-item"><span class="idle-readiness-label">Enabled schedules</span><span class="idle-readiness-value">@overview.EnabledSchedules</span></div>
            <div class="idle-readiness-item"><span class="idle-readiness-label">Outbox messages waiting</span><span class="idle-readiness-value">@overview.PendingOutboxMessages</span></div>
        </div>
    </section>
}
else
{
<div class="metric-grid">
    <section class="metric-card">
        <div class="metric-head"><span>Jobs in progress</span><span class="metric-glyph" aria-hidden="true">↗</span></div>
        <div class="metric-value">@activeRuns</div>
        <div class="metric-detail">
            <span><strong>@overview.PendingRuns</strong> waiting</span>
            <span><strong>@overview.RunningRuns</strong> running</span>
        </div>
        <div class="metric-explainer">Waiting jobs are Runs that have not started yet; running jobs currently have an active Attempt.</div>
    </section>
    <section class="metric-card">
        <div class="metric-head"><span>Worker slots available</span><span class="metric-glyph" aria-hidden="true">▤</span></div>
        <div class="metric-value">@overview.AvailableWorkerSlots<small>of @overview.TotalWorkerCapacity</small></div>
        <div class="metric-detail">
            <span><strong>@overview.ReadyWorkers</strong> ready workers</span>
            <span><strong>@overview.DrainingWorkers</strong> draining</span>
        </div>
        <div class="metric-explainer">A slot is one job a worker can start without exceeding its configured concurrency.</div>
    </section>
    <section class="metric-card">
        <div class="metric-head"><span>Completed in the last hour</span><span class="metric-glyph" aria-hidden="true">✓</span></div>
        <div class="metric-value">@overview.LastHour.CompletedRuns</div>
        <div class="metric-detail">
            <span><strong class="text-success">@overview.LastHour.SucceededRuns</strong> succeeded</span>
            <span><strong>@overview.LastHour.CanceledRuns</strong> canceled</span>
        </div>
        <div class="metric-explainer">A recent activity window is more useful for current operations than an all-time total.</div>
    </section>
    <section class="metric-card">
        <div class="metric-head"><span>Needs review in the last hour</span><span class="metric-glyph" aria-hidden="true">!</span></div>
        <div class="metric-value @(overview.LastHour.UnsuccessfulRuns > 0 ? "text-danger" : "")">@overview.LastHour.UnsuccessfulRuns</div>
        <div class="metric-detail">
            <span><strong>@overview.LastHour.FailedRuns</strong> failed</span>
            <span><strong>@overview.LastHour.DeadRuns</strong> no retries left</span>
        </div>
        <div class="metric-explainer">Failed jobs stopped with an error; Dead jobs used all configured Attempts.</div>
    </section>
</div>

}

@if (!operational.IsIdle)
{
<div class="dashboard-grid">
    <section class="panel">
        <div class="panel-header">
            <div>
                <h2>Queue backlog</h2>
                <div class="panel-subtitle">Shows where work is waiting and how long the oldest claimable job has waited.</div>
            </div>
            <a asp-action="Runs" class="btn btn-sm btn-outline-primary">Open jobs</a>
        </div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead><tr><th scope="col">Queue</th><th scope="col">Waiting</th><th scope="col">Running</th><th scope="col">Oldest wait</th><th scope="col" class="text-end">Active jobs</th></tr></thead>
                <tbody>
                @if (overview.Queues.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">No queues currently have waiting or running jobs.</td></tr>
                }
                else
                {
                    @foreach (var queue in overview.Queues)
                    {
                        <tr>
                            <td><a asp-action="Runs" asp-route-queue="@queue.Queue" class="fw-semibold text-decoration-none">@queue.Queue</a></td>
                            <td><span class="badge bg-warning-subtle text-warning-emphasis">@queue.PendingRuns</span></td>
                            <td><span class="badge bg-primary-subtle text-primary">@queue.RunningRuns</span></td>
                            <td class="small">
                                @if (queue.OldestReadyAt is null)
                                {
                                    <span class="text-muted" title="No waiting job in this queue is ready to run yet.">Not ready yet</span>
                                }
                                else
                                {
                                    var age = overview.ObservedAt - queue.OldestReadyAt.Value;
                                    <span class="@(age >= TimeSpan.FromMinutes(5) ? "text-danger fw-semibold" : "text-muted")"
                                          title="Ready since @queue.OldestReadyAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")">@DashboardOperationalSummary.FormatAge(age)</span>
                                }
                            </td>
                            <td class="text-end fw-bold">@queue.ActiveRuns</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <div>
                <h2>Control-plane shortcuts</h2>
                <div class="panel-subtitle">Use these views to understand capacity, handler coverage, and recurring work.</div>
            </div>
        </div>
        <ul class="shortcut-list">
            <li class="shortcut-item">
                <span><a asp-action="Workers">Worker coverage</a><span class="shortcut-detail">@overview.ReadyWorkers Ready · @overview.AvailableWorkerSlots available slots</span></span>
                <a asp-action="Workers" class="btn btn-sm btn-outline-primary">Open</a>
            </li>
            <li class="shortcut-item">
                <span><a asp-action="JobTypes">Job key catalog</a><span class="shortcut-detail">Verify which handlers are currently advertised by Workers.</span></span>
                <a asp-action="JobTypes" class="btn btn-sm btn-outline-primary">Open</a>
            </li>
            <li class="shortcut-item">
                <span><a asp-action="Schedules">Recurring jobs</a><span class="shortcut-detail">@overview.EnabledSchedules enabled · @overview.DisabledSchedules paused</span></span>
                <a asp-action="Schedules" class="btn btn-sm btn-outline-primary">Open</a>
            </li>
        </ul>
    </section>
</div>

<section class="panel">
    <div class="panel-header">
        <div>
            <h2>Recent jobs</h2>
            <div class="panel-subtitle"><strong>Run</strong> means one logical job. A retry creates another <strong>Attempt</strong> under the same Run.</div>
        </div>
        <a asp-action="Runs" class="btn btn-sm btn-outline-primary">View all jobs</a>
    </div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead><tr><th scope="col">Job run</th><th scope="col">Job type</th><th scope="col">Queue</th><th scope="col">Status</th><th scope="col">Attempts</th><th scope="col">Submitted</th></tr></thead>
            <tbody>
            @if (overview.RecentRuns.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-5">No jobs have been submitted yet. Submit one from your application and it will appear here.</td></tr>
            }
            else
            {
                @foreach (var run in overview.RecentRuns)
                {
                    var badge = run.Phase switch
                    {
                        JobPhase.Succeeded => "bg-success-subtle text-success",
                        JobPhase.Running => "bg-primary-subtle text-primary",
                        JobPhase.Pending => "bg-warning-subtle text-warning-emphasis",
                        JobPhase.Canceled => "bg-secondary-subtle text-secondary",
                        JobPhase.Dead => "bg-dark-subtle text-dark",
                        _ => "bg-danger-subtle text-danger"
                    };
                    var statusText = run.Phase switch
                    {
                        JobPhase.Pending => "Waiting",
                        JobPhase.Running => "Running",
                        JobPhase.Succeeded => "Succeeded",
                        JobPhase.Failed => "Failed",
                        JobPhase.Canceled => "Canceled",
                        JobPhase.Dead => "No retries left",
                        _ => run.Phase.ToString()
                    };
                    <tr>
                        <td><a asp-action="Run" asp-route-id="@run.Id" class="mono fw-semibold text-decoration-none" title="Open Run @run.Id">@run.Id[..Math.Min(10, run.Id.Length)]</a></td>
                        <td class="fw-semibold">@run.JobKey</td>
                        <td><span class="badge bg-light text-dark border">@run.Queue</span></td>
                        <td><span class="badge @badge" title="KubeJob phase: @run.Phase">@statusText</span></td>
                        <td title="Attempts used / maximum Attempts">@run.AttemptCount / @run.MaxAttempts</td>
                        <td class="text-muted small">@run.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
}
