@model DashboardWorkersViewModel
@{
    ViewData["Title"] = "Worker Sessions";
}
<meta http-equiv="refresh" content="15">

<div class="section-header d-flex justify-content-between align-items-center">
    <div>
        <h5 class="mb-1 fw-bold">Worker sessions</h5>
        <div class="small text-muted">WorkerId is stable; SessionId and Epoch fence restarts and stale processes.</div>
    </div>
    <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()"><i class="fa-solid fa-rotate me-1"></i>Refresh</button>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Worker / session</th><th>State</th><th>Capacity</th><th>Queues</th><th>Capabilities</th><th>Labels</th><th>Build / heartbeat</th></tr></thead>
            <tbody>
            @if (Model.Sessions.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-5">No worker session has registered.</td></tr>
            }
            else
            {
                @foreach (var session in Model.Sessions)
                {
                    var used = Math.Max(0, session.MaxConcurrency - session.AvailableSlots);
                    var percent = session.MaxConcurrency == 0 ? 0 : (int)Math.Round(used * 100d / session.MaxConcurrency);
                    var heartbeatAge = Model.ObservedAt - session.LastHeartbeatAt;
                    var stateClass = session.State switch
                    {
                        WorkerSessionState.Ready => "bg-success-subtle text-success",
                        WorkerSessionState.Draining => "bg-warning-subtle text-warning-emphasis",
                        WorkerSessionState.Closed => "bg-secondary-subtle text-secondary",
                        _ => "bg-danger-subtle text-danger"
                    };
                    <tr>
                        <td>
                            <div class="fw-bold">@session.WorkerId</div>
                            <div class="mono small text-muted">@session.SessionId</div>
                            <div class="small text-muted">epoch @session.Epoch · @session.HostName</div>
                        </td>
                        <td><span class="badge @stateClass">@session.State</span></td>
                        <td style="min-width: 150px">
                            <div class="d-flex justify-content-between small mb-1"><span>@used running</span><span>@session.AvailableSlots free / @session.MaxConcurrency</span></div>
                            <div class="progress" style="height: 6px"><div class="progress-bar" style="width: @percent%"></div></div>
                        </td>
                        <td><div class="d-flex flex-wrap gap-1">@foreach (var queue in session.Queues){<span class="badge bg-light text-dark border">@queue</span>}</div></td>
                        <td><div class="d-flex flex-wrap gap-1">@foreach (var capability in session.Capabilities){<span class="badge bg-primary-subtle text-primary">@capability</span>}</div></td>
                        <td>
                            @if (session.Labels.Count == 0)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-1">@foreach (var label in session.Labels){<span class="badge bg-light text-dark border">@label.Key=@label.Value</span>}</div>
                            }
                        </td>
                        <td class="small">
                            <div>@(session.BuildId ?? "unknown")</div>
                            <div class="text-muted">@session.LastHeartbeatAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                            <div class="@(heartbeatAge > TimeSpan.FromSeconds(30) ? "text-danger" : "text-success")">@heartbeatAge.TotalSeconds.ToString("0")s ago</div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
