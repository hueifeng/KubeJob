@using KubeJob.ControlPlane.Runtime
@using KubeJob.Core.Runtime
@model DashboardJobTypesViewModel
@{
    ViewData["Title"] = "Job keys";
}
<div class="section-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h2 class="mb-1 fw-bold">Observed job keys</h2>
        <div class="small text-muted">
            This live catalog is observed from Worker capabilities, recent Runs, and configured Schedules. It is not a permanent registry; a key with no Ready Worker cannot execute until a matching Worker connects.
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-scroll-hint">Scroll sideways to see worker coverage, activity, and schedules →</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th scope="col">Job key</th>
                    <th scope="col">Availability</th>
                    <th scope="col">Workers</th>
                    <th scope="col">Worker-advertised queues</th>
                    <th scope="col">Recent activity</th>
                    <th scope="col">Schedules</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.JobTypes.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-5">
                        <div class="fw-semibold text-dark mb-1">No job keys have been observed.</div>
                        <div>Connect a Worker, submit a Run, or create a Schedule to populate this observation view.</div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var jobType in Model.JobTypes)
                {
                    var availabilityClass = jobType.IsAvailable
                        ? "bg-success-subtle text-success"
                        : "bg-warning-subtle text-warning-emphasis";
                    var availabilityText = jobType.IsAvailable
                        ? "Ready"
                        : "No ready Worker";
                    var lastPhaseText = jobType.LastPhase?.ToString() ?? "No recent Run";
                    <tr>
                        <td>
                            <div class="fw-bold mono">@jobType.JobKey</div>
                            <div class="small text-muted">Stable handler identity; not a Run ID.</div>
                        </td>
                        <td><span class="badge @availabilityClass">@availabilityText</span></td>
                        <td>
                            <div><strong>@jobType.ReadyWorkerCount</strong> ready / @jobType.WorkerCount known</div>
                            @if (jobType.WorkerIds.Count > 0)
                            {
                                <div class="small text-muted">@string.Join(", ", jobType.WorkerIds)</div>
                            }
                        </td>
                        <td>
                            @if (jobType.Queues.Count == 0)
                            {
                                <span class="text-muted small">None advertised</span>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var queue in jobType.Queues)
                                    {
                                        <span class="badge bg-light text-dark border">@queue</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            <div><strong>@jobType.RecentRunCount</strong> Run(s)</div>
                            <div class="small text-muted">@lastPhaseText · last @((jobType.LastRunAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")) ?? "never")</div>
                            <div class="small text-muted">Recent window: last @Model.RecentRunLimit Runs</div>
                        </td>
                        <td>
                            @if (jobType.ScheduleCount == 0)
                            {
                                <span class="text-muted">None</span>
                            }
                            else
                            {
                                <a asp-action="Schedules" class="text-decoration-none">@jobType.ScheduleCount configured</a>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Runs" asp-route-jobKey="@jobType.JobKey" asp-route-exactJobKey="true" class="btn btn-sm btn-outline-primary">View Runs</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
