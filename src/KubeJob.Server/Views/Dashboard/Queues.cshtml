@model DashboardQueuesViewModel
@{
    ViewData["Title"] = "Queues";
}
<div class="section-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h2 class="mb-1 fw-bold">Queue inventory</h2>
        <div class="small text-muted">
            A logical Queue has one execution authority. PostgresManaged queues are claimed from PostgreSQL;
            BrokerNative queues are delivered directly by the configured transport. Broker-specific physical
            retry, DLQ, exchange, and partition topology is intentionally hidden here.
            Showing @Model.Entries.Count queues; @Model.ActiveWorkerCount active managed worker sessions as of @Model.ObservedAt.ToLocalTime():HH:mm:ss.
        </div>
    </div>
</div>

@if (Model.Entries.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon"><i class="fa-solid fa-route" aria-hidden="true"></i></div>
        <div class="empty-state-title">No queues yet</div>
        <div class="empty-state-detail">
            Queues appear here once they are configured or registered by a managed worker session.
        </div>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                <tr>
                    <th scope="col">Logical queue</th>
                    <th scope="col">Runtime</th>
                    <th scope="col">Transport</th>
                    <th scope="col">Managed lane</th>
                    <th scope="col">Managed group</th>
                    <th scope="col">Ordering</th>
                    <th scope="col">Managed workers</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var queue in Model.Entries)
                {
                    <tr>
                        <td><code class="queue-name">@queue.LogicalQueue</code></td>
                        <td>
                            <span class="badge text-bg-@(queue.RuntimeMode == KubeJob.Core.Runtime.QueueRuntimeMode.BrokerNative ? "primary" : "secondary")">
                                @queue.RuntimeMode
                            </span>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(queue.TransportId) ? "—" : queue.TransportId)</td>
                        <td>@(string.IsNullOrWhiteSpace(queue.ExecutionLane) ? "—" : queue.ExecutionLane)</td>
                        <td>@(string.IsNullOrWhiteSpace(queue.ConsumerGroup) ? "—" : queue.ConsumerGroup)</td>
                        <td>@(queue.OrderingMode?.ToString() ?? "transport-native")</td>
                        <td>@queue.ActiveWorkerCount</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<style>
    .queue-name { font-weight: 600; }
    .empty-state {
        border: 1px dashed var(--border-strong);
        border-radius: 6px;
        padding: 32px;
        text-align: center;
        background: var(--surface);
    }
    .empty-state-icon { font-size: 22px; color: var(--muted); margin-bottom: 8px; }
    .empty-state-title { font-weight: 650; margin-bottom: 4px; }
    .empty-state-detail { color: var(--muted); font-size: 12px; }
</style>
