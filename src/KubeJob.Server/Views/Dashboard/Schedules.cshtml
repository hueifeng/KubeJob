@using KubeJob.Core.Scheduling
@model DashboardSchedulesViewModel
@{
    ViewData["Title"] = "Schedules";
}
@if (Model.AllowMutatingActions)
{
    <style>
        .schedule-dialog {
            width: min(780px, calc(100vw - 32px));
            max-height: calc(100vh - 32px);
            padding: 0;
            border: 1px solid var(--border-strong);
            border-radius: 8px;
            box-shadow: 0 18px 60px rgba(0, 0, 0, .22);
        }
        .schedule-dialog::backdrop { background: rgba(15, 23, 42, .42); }
        .schedule-dialog-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            padding: 18px 20px;
            border-bottom: 1px solid var(--border);
        }
        .schedule-dialog-body { max-height: calc(100vh - 190px); overflow-y: auto; padding: 20px; }
        .schedule-dialog-close { min-width: 32px; padding: 4px 8px; font-size: 18px; line-height: 1; }
        .schedule-dialog-footer { display: flex; justify-content: flex-end; gap: 8px; padding-top: 4px; }
        .schedule-help { color: var(--muted); font-size: 12px; line-height: 1.45; }
    </style>
}

<div class="section-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h5 class="mb-1 fw-bold">Recurring jobs</h5>
        <div class="small text-muted">
            A Schedule creates a new job Run whenever its cron expression is due. Time zone, missed-run behavior, retries, and overlap rules belong to the Schedule.
            Showing up to @Model.MaximumItems schedules.
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (Model.AllowMutatingActions)
        {
            <button type="button" class="btn btn-primary" id="open-create-schedule">
                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>New recurring job
            </button>
        }
        else
        {
            <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">
                <i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Viewing only
            </span>
        }
    </div>
</div>

@if (Model.AllowMutatingActions)
{
    <dialog id="create-schedule-dialog" class="schedule-dialog" data-open="@(Model.ShowCreateForm ? "true" : "false")" aria-labelledby="create-schedule-title">
        <div class="schedule-dialog-header">
            <div>
                <h5 id="create-schedule-title" class="mb-1 fw-bold">New recurring job</h5>
                <div class="schedule-help">
                    Create a Schedule that emits a new Run when its Cron expression is due. The Job key identifies the registered handler; it is not a Run ID.
                </div>
            </div>
            <button type="button" class="btn btn-outline-secondary schedule-dialog-close" aria-label="Close">×</button>
        </div>
        <form asp-action="CreateSchedule" method="post" class="schedule-dialog-body">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="CreateForm.Id" class="form-label">Schedule ID</label>
                    <input asp-for="CreateForm.Id" class="form-control" placeholder="daily-report" />
                    <span asp-validation-for="CreateForm.Id" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CreateForm.JobKey" class="form-label">Job key</label>
                    <input asp-for="CreateForm.JobKey" class="form-control" placeholder="sample.data" />
                    <div class="schedule-help mt-1">Use a registered handler key such as <code>sample.data</code> or <code>sample.dashboard-demo</code>. Do not enter a Run ID. See <a asp-action="JobTypes">Observed Job Types</a> for currently advertised keys.</div>
                    <span asp-validation-for="CreateForm.JobKey" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CreateForm.CronExpression" class="form-label">Cron expression</label>
                    <input asp-for="CreateForm.CronExpression" class="form-control mono" placeholder="*/5 * * * *" />
                    <span asp-validation-for="CreateForm.CronExpression" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CreateForm.TimeZoneId" class="form-label">Time zone</label>
                    <input asp-for="CreateForm.TimeZoneId" class="form-control" placeholder="UTC" />
                    <span asp-validation-for="CreateForm.TimeZoneId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CreateForm.Queue" class="form-label">Queue</label>
                    <input asp-for="CreateForm.Queue" class="form-control" placeholder="default" />
                    <span asp-validation-for="CreateForm.Queue" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CreateForm.Priority" class="form-label">Priority</label>
                    <input asp-for="CreateForm.Priority" class="form-control" type="number" />
                </div>
                <div class="col-md-6">
                    <label asp-for="CreateForm.MisfirePolicy" class="form-label">Missed-run behavior</label>
                    <select asp-for="CreateForm.MisfirePolicy" class="form-select">
                        @foreach (var policy in Enum.GetValues<MisfirePolicy>())
                        {
                            <option value="@((int)policy)">@policy</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="CreateForm.ConcurrencyPolicy" class="form-label">Overlap behavior</label>
                    <select asp-for="CreateForm.ConcurrencyPolicy" class="form-select">
                        @foreach (var policy in Enum.GetValues<ScheduleConcurrencyPolicy>())
                        {
                            <option value="@((int)policy)">@policy</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="CreateForm.MaxAttempts" class="form-label">Max attempts</label>
                    <input asp-for="CreateForm.MaxAttempts" class="form-control" type="number" min="1" />
                    <span asp-validation-for="CreateForm.MaxAttempts" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CreateForm.TimeoutSeconds" class="form-label">Timeout (seconds)</label>
                    <input asp-for="CreateForm.TimeoutSeconds" class="form-control" type="number" min="1" />
                    <span asp-validation-for="CreateForm.TimeoutSeconds" class="text-danger small"></span>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="CreateForm.Enabled" class="form-check-input" />
                        <label asp-for="CreateForm.Enabled" class="form-check-label">Start enabled</label>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="CreateForm.PayloadJson" class="form-label">Payload JSON</label>
                    <textarea asp-for="CreateForm.PayloadJson" class="form-control mono" rows="4"></textarea>
                    <div class="schedule-help mt-1">Payload must match the contract expected by the selected Job key.</div>
                    <span asp-validation-for="CreateForm.PayloadJson" class="text-danger small"></span>
                </div>
                <div class="col-12 schedule-dialog-footer">
                    <button type="button" class="btn btn-outline-secondary schedule-dialog-close">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Create Schedule
                    </button>
                </div>
            </div>
        </form>
    </dialog>
    <script>
        (() => {
            const dialog = document.getElementById('create-schedule-dialog');
            const openButton = document.getElementById('open-create-schedule');
            if (!dialog || !openButton) return;
            const openDialog = () => typeof dialog.showModal === 'function'
                ? dialog.showModal()
                : dialog.setAttribute('open', '');
            const closeDialog = () => typeof dialog.close === 'function'
                ? dialog.close()
                : dialog.removeAttribute('open');
            openButton.addEventListener('click', openDialog);
            dialog.querySelectorAll('.schedule-dialog-close').forEach(button => {
                button.addEventListener('click', closeDialog);
            });
            dialog.addEventListener('click', event => {
                if (event.target === dialog) closeDialog();
            });
            if (dialog.dataset.open === 'true') openDialog();
        })();
    </script>
}

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th scope="col">Schedule</th><th scope="col">Job type / queue</th><th scope="col">When it runs</th><th scope="col">Missed runs / overlap</th><th scope="col">Next / previous run</th><th scope="col">Status</th>@if (Model.AllowMutatingActions){<th scope="col" class="text-end">Action</th>}</tr></thead>
            <tbody>
            @if (Model.Schedules.Count == 0)
            {
                <tr>
                    <td colspan="@(Model.AllowMutatingActions ? 7 : 6)" class="text-center text-muted py-5">
                        <div class="fw-semibold text-dark mb-1">No recurring jobs have been configured.</div>
                        @if (Model.AllowMutatingActions)
                        {
                            <div>Use <strong>New recurring job</strong> or create a Schedule through <code>IJobScheduleClient</code>.</div>
                        }
                        else
                        {
                            <div>Create a Schedule through <code>IJobScheduleClient</code> or ask an administrator to configure one.</div>
                        }
                    </td>
                </tr>
            }
            else
            {
                @foreach (var schedule in Model.Schedules)
                {
                    var claimActive = schedule.ClaimUntil is not null && schedule.ClaimUntil > DateTimeOffset.UtcNow;
                    var misfireText = schedule.MisfirePolicy switch
                    {
                        MisfirePolicy.FireOnce => "Run once after downtime",
                        MisfirePolicy.SkipMissed => "Skip missed times",
                        _ => schedule.MisfirePolicy.ToString()
                    };
                    var concurrencyText = schedule.ConcurrencyPolicy switch
                    {
                        ScheduleConcurrencyPolicy.Allow => "Allow overlapping runs",
                        ScheduleConcurrencyPolicy.SkipIfRunning => "Skip while previous run is active",
                        _ => schedule.ConcurrencyPolicy.ToString()
                    };
                    <tr>
                        <td>
                            <div class="fw-bold">@schedule.Id</div>
                            <div class="small text-muted" title="Optimistic concurrency version">configuration version @schedule.Version</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@schedule.JobKey</div>
                            <span class="badge bg-light text-dark border">@schedule.Queue</span>
                            @if (schedule.Priority != 0)
                            {
                                <span class="small text-muted">priority @schedule.Priority</span>
                            }
                        </td>
                        <td>
                            <div class="mono" title="Cron expression">@schedule.CronExpression</div>
                            <div class="small text-muted">Time zone: @schedule.TimeZoneId</div>
                        </td>
                        <td>
                            <div><span class="badge bg-info-subtle text-info-emphasis" title="KubeJob policy: @schedule.MisfirePolicy">@misfireText</span></div>
                            <div class="mt-1"><span class="badge bg-primary-subtle text-primary" title="KubeJob policy: @schedule.ConcurrencyPolicy">@concurrencyText</span></div>
                            <div class="small text-muted mt-1">Up to @schedule.MaxAttempts attempt(s) · @schedule.TimeoutSeconds-second timeout</div>
                        </td>
                        <td class="small">
                            <div><i class="fa-solid fa-forward-step text-primary me-1" aria-hidden="true"></i><strong>Next:</strong> @schedule.NextFireAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                            <div class="text-muted mt-1"><i class="fa-solid fa-clock-rotate-left me-1" aria-hidden="true"></i><strong>Previous:</strong> @(schedule.LastFireAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "Never run")</div>
                        </td>
                        <td>
                            @if (schedule.Enabled)
                            {
                                <span class="badge bg-success-subtle text-success">Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Paused</span>
                            }
                            @if (claimActive)
                            {
                                <div class="small text-primary mt-1" title="A control-plane instance temporarily owns schedule reconciliation."><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Creating due run</div>
                            }
                        </td>
                        @if (Model.AllowMutatingActions)
                        {
                            <td class="text-end">
                                <form asp-action="SetScheduleEnabled" asp-route-id="@schedule.Id" method="post" onsubmit="return confirm('@(schedule.Enabled ? "Pause this schedule? No new runs will be created until it is resumed." : "Resume this schedule?")');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="enabled" value="@(!schedule.Enabled)" />
                                    <button class="btn btn-sm @(schedule.Enabled ? "btn-outline-warning" : "btn-outline-success")">
                                        <i class="fa-solid @(schedule.Enabled ? "fa-pause" : "fa-play") me-1" aria-hidden="true"></i>@(schedule.Enabled ? "Pause" : "Resume")
                                    </button>
                                </form>
                                <form asp-action="DeleteSchedule" asp-route-id="@schedule.Id" method="post" class="mt-2" onsubmit="return confirm('Delete this recurring job?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash me-1" aria-hidden="true"></i>Delete
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
