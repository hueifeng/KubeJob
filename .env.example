# Copy to .env only when you need to override the development defaults.
# .env is ignored by Git. These credentials are intentionally development-only.

KUBEJOB_POSTGRES_VERSION=17-alpine
KUBEJOB_POSTGRES_DB=kubejob
KUBEJOB_POSTGRES_USER=kubejob
KUBEJOB_POSTGRES_PASSWORD=kubejob-dev
KUBEJOB_POSTGRES_PORT=5432

KUBEJOB_RABBITMQ_VERSION=4-management-alpine
KUBEJOB_RABBITMQ_USER=kubejob
KUBEJOB_RABBITMQ_PASSWORD=kubejob-dev
KUBEJOB_RABBITMQ_VHOST=/
KUBEJOB_RABBITMQ_PORT=5672
KUBEJOB_RABBITMQ_MANAGEMENT_PORT=15672
