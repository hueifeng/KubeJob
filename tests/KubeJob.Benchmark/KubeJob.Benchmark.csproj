<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>KubeJob.Benchmark</RootNamespace>
    <AssemblyName>KubeJob.Benchmark</AssemblyName>
    <!--
      A repeatable throughput harness, not a published artifact. Excluded from
      packaging and intentionally kept out of the test runner path so it runs on
      demand instead of on every `dotnet test`.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Npgsql and RabbitMQ.Client flow transitively from the storage/transport
      projects below; the harness uses them directly only for metrics probing
      and ingress publishing, so no extra PackageReference is pinned here.
    -->
    <ProjectReference Include="..\..\src\KubeJob\KubeJob.csproj" />
    <ProjectReference Include="..\..\src\KubeJob.Core\KubeJob.Core.csproj" />
    <ProjectReference Include="..\..\src\KubeJob.Server\KubeJob.Server.csproj" />
    <ProjectReference Include="..\..\src\KubeJob.Worker\KubeJob.Worker.csproj" />
    <ProjectReference Include="..\..\src\KubeJob.Storage.PostgreSQL\KubeJob.Storage.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\KubeJob.Transport.RabbitMQ\KubeJob.Transport.RabbitMQ.csproj" />
  </ItemGroup>

</Project>