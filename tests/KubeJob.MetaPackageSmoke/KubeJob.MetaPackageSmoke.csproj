<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <KubeJobSmokeVersion Condition="'$(KubeJobSmokeVersion)' == ''">0.0.0-local</KubeJobSmokeVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KubeJob" Version="$(KubeJobSmokeVersion)" />
  </ItemGroup>

</Project>
